# Copy this file to hw4/.env and fill in your own key. Never commit the real .env.

# Required: your Portkey API key (OpenAI-compatible gateway).
PORTKEY_API_KEY=your-portkey-key-here
# Optional: Portkey gateway (default shown).
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Model routing (Problem 9): cheap/fast tier for simple questions, stronger tier for
# multi-step or unclear ones. The fast tier runs with reasoning off on /chat/completions;
# the smart tier runs on /responses with reasoning on (needed for tools + reasoning).
FAST_MODEL=gpt-6-luna
SMART_MODEL=gpt-6-luna
SMART_REASONING_EFFORT=medium

# In-memory cache for catalogue + inventory lookups (seconds).
CACHE_TTL_SECONDS=60
# Per-turn limits.
MAX_TOOL_CALLS_PER_TURN=8
MAX_HISTORY_MESSAGES=10

# Safety limits (prompts/prompt.md "Safety rules"; harness §12)
MAX_MESSAGE_CHARS=1000
MAX_HISTORY_TURN_CHARS=2000
MAX_HISTORY_TURNS_ACCEPTED=20
MAX_MODEL_REQUESTS_PER_TURN=8

# Where each request's routing decision is logged (relative to the project root).
AUDIT_TRAIL_PATH=output/audit_trail.json

# Label stamped on every audit_trail.json entry; bump it when the agent's design changes (harness §10).
AGENT_VERSION=v2-fact-check
